# Copy the DEVELOPMENT block to .env (and .env.local for overrides).
# Copy the PRODUCTION block to .env.production, and set the same keys in the hosting dashboard.
# Both blocks use identical keys so every environment behaves the same way.

# ---------------------------------------------------------------------------
# DEVELOPMENT (.env)
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000

SUPABASE_PASSWORD=your-dev-supabase-password
NEXT_PUBLIC_SUPABASE_URL=your-dev-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-supabase-service-role-key
SUPABASE_SECRET_KEY=your-dev-supabase-secret-key
SUPABASE_PUBLISHABLE_KEY=your-dev-supabase-publishable-key
SUPABASE_JWT_SECRET=your-dev-supabase-jwt-secret

SUPABASE_EMAIL_SMTP_USERNAME=your-brevo-smtp-login
SUPABASE_EMAIL_SMTP_PASSWORD=your-brevo-smtp-key

# Brevo SMTP relay (Brevo dashboard > SMTP & API). EMAIL_FROM must be a verified Brevo sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM="CVTEC EDMS <your-verified-sender@example.com>"

# ---------------------------------------------------------------------------
# PRODUCTION (.env.production)
# ---------------------------------------------------------------------------
SITE_URL=https://your-production-domain.com

SUPABASE_PASSWORD=your-prod-supabase-password
NEXT_PUBLIC_SUPABASE_URL=your-prod-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-supabase-service-role-key
SUPABASE_SECRET_KEY=your-prod-supabase-secret-key
SUPABASE_PUBLISHABLE_KEY=your-prod-supabase-publishable-key
SUPABASE_JWT_SECRET=your-prod-supabase-jwt-secret

SUPABASE_EMAIL_SMTP_USERNAME=your-brevo-smtp-login
SUPABASE_EMAIL_SMTP_PASSWORD=your-brevo-smtp-key

# Same Brevo relay as development; use the production sender or authenticated domain.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM="CVTEC EDMS <no-reply@your-production-domain.com>"
